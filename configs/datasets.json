{
  "schema_version": 1,
  "status": "fixed_preprocessing_protocol",
  "preprocessing": {
    "min_history": 1,
    "max_history_export": 50,
    "positive_rating_threshold": 4.0,
    "split_quantiles": [
      0.7,
      0.8,
      0.9
    ],
    "split_names": [
      "train",
      "development",
      "calibration",
      "test"
    ],
    "example_policy": "latest_eligible_positive_per_user_per_split",
    "metadata_policy": "static_catalog_snapshot_no_historical_metadata_claim",
    "duplicate_policy": "retain_distinct_source_rows_with_stable_surrogate_ids"
  },
